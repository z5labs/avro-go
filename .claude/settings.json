{
  "enabledPlugins": {
    "backlog@z5labs-devex": true
  },
  "extraKnownMarketplaces": {
    "z5labs-devex": {
      "source": {
        "source": "github",
        "repo": "z5labs/devex"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/install-plugins.sh"
          }
        ]
      }
    ]
  }
}
